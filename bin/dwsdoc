#!/usr/bin/env python3
"""dwsdoc — kb-dws-wiki 实体检索 CLI(对齐 kb-dingtalk-open-platform 的 dkdoc)。

用法:
  dwsdoc ctx <词>     ★一次打包检索:答案卡+cmd/short/flag+按需正文/notes(默认入口)
  dwsdoc ctx --full <词>  强制旧版全文路径(跳过答案卡,用于回退/深查)
  dwsdoc card <命令>  打印确定性答案卡(full 可直答;partial 还须读正文)
  dwsdoc cmd <词>     按命令名/描述搜主命令树(graph/commands.jsonl),显示 flags+源码行号
  dwsdoc short <词>   搜 +xxx 短命令(graph/shortcuts.jsonl)
  dwsdoc flag <名>    跨全部命令搜某个 flag 名(答"哪个命令有 --xxx")
  dwsdoc find <词>    搜 docs/(镜像层)+notes/(行为语义层)篇目标题与标题栏
  dwsdoc cat <path>   打印仓库内文件
说明:命中即事实(含 文件:行号 供回引);查不到≠不存在,请回退源码 grep。
"""
import json
import math
import os
import re
import sys
from urllib.parse import quote

_CTX_BODY_CAP = 8000
_CTX_TOTAL_CAP = 20000

# 中英术语双向表:graph/commands.jsonl 里 187/807(23%) 条命令的 desc/when 是纯英文
# (上游源码注释直出),中文提问("审批 实例 发起")对这批命令的召回恒为 0 ——
# 模型查不到就转而断言"不支持"(实录 Q238 把正确的 oa approval create-instance
# 答成"不支持发起审批"; Q290 aisearch behavior、Q217 conversation-info 同源)。
# 这不是逐题补丁:一张领域术语表把中英两侧打通,对全部英文条目一次性生效。
_TERM_GROUPS = [
    # 动作
    ("创建", "新建", "发起", "提交", "create", "start", "launch", "submit", "new"),
    ("查询", "查看", "获取", "列出", "get", "list", "query", "search", "fetch", "show", "info"),
    ("删除", "移除", "清空", "delete", "remove", "clear", "revoke"),
    ("更新", "修改", "设置", "update", "modify", "set", "edit", "patch"),
    ("发送", "推送", "send", "push"),
    ("上传", "upload"), ("下载", "download"), ("导出", "export"), ("导入", "import"),
    ("取消", "撤回", "cancel", "recall", "withdraw"),
    ("同意", "通过", "审批通过", "approve"), ("拒绝", "驳回", "reject", "refuse"),
    ("添加", "加入", "add", "join"), ("转发", "forward"), ("绑定", "bind"),
    ("授权", "authorize", "grant"),
    ("解析", "提取", "读取", "投影", "parse", "extract", "read", "pull", "project"),
    # 实体
    ("审批", "approval", "approve"), ("实例", "instance"), ("模板", "template"),
    ("附件", "attachment"), ("文件", "file"), ("媒体", "media"),
    ("消息", "message", "msg"), ("卡片", "card"), ("文本", "文字", "text"),
    ("群", "群聊", "group", "chat"), ("会话", "对话", "conversation", "session"),
    ("用户", "成员", "user", "member", "staff"),
    ("部门", "组织", "department", "dept", "org"),
    ("日程", "日历", "calendar", "event", "schedule"),
    ("待办", "任务", "todo", "task"),
    ("考勤", "attendance"), ("打卡", "checkin", "punch"), ("请假", "leave"),
    ("加班", "overtime"), ("出差", "trip", "travel"), ("补卡", "supply"),
    ("直播", "live"), ("会议", "meeting", "conference"),
    ("文档", "知识库", "doc", "document", "drive", "space", "knowledge", "wiki"),
    ("表格", "多维表", "sheet", "excel", "table", "aitable"),
    ("机器人", "robot", "bot"), ("应用", "app", "application"),
    ("权限", "permission", "auth", "scope"), ("角色", "role"),
    ("通讯录", "contact"), ("日志", "log"), ("记录", "历史", "record", "history"),
    ("搜索", "search"), ("通知", "提醒", "notify", "notice", "noticer", "remind"),
    ("评论", "comment"), ("抄送", "cc"), ("标签", "tag", "label"),
    ("配置", "设置项", "config", "setting", "option"),
    ("凭证", "令牌", "token", "credential"),
    ("登录", "登陆", "login", "signin", "authenticate"),
    ("企业", "组织", "corp", "enterprise", "org"),
    ("宜搭", "yida"), ("行为", "操作", "behavior", "action", "operation"),
    # 复合意图必须独立成组:"操作记录"是 behavior search,不能拆成"操作"+"记录"后
    # 与本地 CLI audit 日志混为一谈(Q290 实录:漏掉 aisearch behavior)。
    ("行为记录", "操作记录", "behavior"),
    ("统计", "stat", "statistics", "count"), ("表单", "form"),
    ("回调", "事件", "callback", "event", "webhook"), ("流程", "process", "flow"),
    # 概念↔实现名映射:用户说的是现象/产品文案,命令与 notes 用的是实现词(实录 Q186/Q283/Q200)
    ("跨组织", "非本组织", "外部组织", "其他组织", "跨企业", "外部企业", "cross-org"),
    ("扇出", "独占", "排他", "只有一个", "其余", "广播", "每个消费者", "fan-out", "fanout", "exclusive"),
    ("通过ai发送", "ai发送", "ai标签", "显示标签", "ai", "ai-tag", "clawtype", "agent-product", "dws_agent_product"),
]
_VARIANTS = {}
for _g in _TERM_GROUPS:
    for _w in _g:
        _VARIANTS.setdefault(_w, set()).update(_g)


def _hit(word, hay):
    """词命中:中文按子串,ASCII 按完整 token,防短词误撞长词。

    不能统一用 `v in hay`:日志的同义词 log 会误命中 login,app 会误命中
    approval/application(Q290 实录:auth login 因 login⊃log 被当成"日志"而排首位)。
    连字符/空格视为 token 边界,所以 event-system 仍可命中 event。
    """
    for v in _VARIANTS.get(word, (word,)):
        if re.fullmatch(r"[a-z0-9_+.\-]+", v):
            if re.search(r"(?<![a-z0-9])" + re.escape(v) + r"(?![a-z0-9])", hay):
                return True
        elif v in hay:
            return True
    return False


# 检索停用词:疑问/虚词无区分度;"dws" 是本库自身名字,正如"钉钉"之于钉钉文档库——
# 它极少出现在 desc 里,IDF 反而给它最高权重,会把仅仅描述里提了一句 dws 的
# 无关命令顶到首位(实录:"dws 怎么登录"返回 aitable info / drive list-spaces)。
_STOPWORDS = {
    "dws", "怎么", "如何", "怎样", "什么", "哪些", "哪个", "是否", "能否", "可以",
    "能不能", "有没有", "支持", "需要", "为什么", "原理", "机制", "原因", "怎么回事",
    "多少", "上限", "有效期", "配额", "几个", "多久", "时长", "过期", "客户端",
    "一下", "请问", "帮我", "我们", "这个", "那个", "的", "了", "吗", "呢", "做",
}


def _tokenize(terms, hays):
    """把自然语言查询切成能在语料里命中的词,不产生跨边界伪词。

    旧 2-gram 对中英混写 `DWS能获取用户…` 会切出 dw/ws/户在；这些伪词因
    罕见拿到最高 IDF,把无关命令顶到首位。现改为:
    1) 先按 ASCII/CJK 脚本分段,避免 dws 与中文黏连;
    2) CJK 优先按领域术语最长匹配(如 操作记录、登录);
    3) 未覆盖片段再从语料做最长匹配,不跨已识别词边界。
    """
    out = []
    lexicon = sorted(
        {v for g in _TERM_GROUPS for v in g
         if len(v) >= 2 and re.fullmatch(r"[一-鿿]+", v)
         and v not in _STOPWORDS},
        key=lambda x: (-len(x), x))

    def add_cjk(s):
        covered = [False] * len(s)
        # 领域词从左到右取最长匹配:旧法按词表顺序全局扫描,"获取消息"会先被"取消"跨边界占位
        # (实录 Q186 分出 取消/组织,正解 cross-org 零命中)。左起最长保证词不跨真实边界。
        i = 0
        while i < len(s):
            best = next((w for w in lexicon if s.startswith(w, i)), "")
            if best:
                out.append(best)
                covered[i:i + len(best)] = [True] * len(best)
                i += len(best)
            else:
                i += 1
        # 标记疑问/虚词,防止"怎么登录"的"怎么"进入语料回退。
        for word in sorted((x for x in _STOPWORDS if len(x) >= 2), key=len, reverse=True):
            start = 0
            while True:
                i = s.find(word, start)
                if i < 0:
                    break
                covered[i:i + len(word)] = [True] * len(word)
                start = i + 1
        # 对仍未覆盖的连续片段,贪心取语料中真实存在的最长子串(2~6字)。
        i = 0
        while i < len(s):
            if covered[i]:
                i += 1
                continue
            end = i
            while end < len(s) and not covered[end]:
                end += 1
            seg, p = s[i:end], 0
            while p < len(seg):
                best = ""
                for n in range(min(6, len(seg) - p), 1, -1):
                    cand = seg[p:p + n]
                    if any(cand in h for h in hays):
                        best = cand
                        break
                if best:
                    out.append(best)
                    p += len(best)
                else:
                    p += 1
            i = end

    for raw in terms:
        # `DWS能获取…` → [dws, 能获取…],而不是 [dw, ws, s能, 能获…]
        for w in re.findall(r"[a-z0-9_+.\-]+|[一-鿿]+", raw.lower()):
            if w in _STOPWORDS:
                continue
            if re.fullmatch(r"[a-z0-9_+.\-]+", w):
                out.append(w)
            else:
                add_cjk(w)
    return list(dict.fromkeys(out))


def _looks_truncated(q):
    """只识别可机械确认的未闭合代码/结构,不把普通省略句误判为残缺。"""
    if q.count("```") % 2:
        return True
    structured = any(c in q for c in "{}[]") or "```" in q
    if not structured:
        return False
    for left, right in (("{", "}"), ("[", "]"), ("(", ")")):
        if q.count(left) != q.count(right):
            return True
    if q.count('"') % 2 or q.count("'") % 2:
        return True
    return bool(re.search(r"(?:[:,=]|=>)\s*$", q))


def _intent(q):
    """问法预判:一次到位决定额外带料,避免模型查完再查。"""
    support = (any(k in q for k in ("支持", "有没有", "有吗", "能不能", "可以吗", "是否", "会不会", "会被", "能否",
                                    "是不是", "对吗", "对不对", "拉不到", "拿不到", "收不到", "查不到"))
               or bool(re.search(r"不是.{0,15}(?:吗|吧)|一样(?:吗|吧)", q))
               or bool(re.search(r"(?:能|可以).{0,3}(?:获取|查询|查看|拿到|取到|做到|实现|解析|发送|创建|删除|使用|读取)", q)))
    capability = any(k in q for k in
                     ("能力", "解析", "提取", "可读文本", "原始结构", "结构化", "渲染", "解密"))
    card_capability = (any(k in q for k in ("卡片", "card"))
                       and any(k in q for k in
                               ("能力", "支持", "解析", "提取", "读取", "文本", "结构", "字段", "渲染", "解密")))
    validation = (any(k in q for k in
                      ("是否合法", "是否有效", "无效", "格式", "uuid", "正则", "pattern", "长度", "前缀",
                       "字符集", "参数不对", "参数错误", "校验规则"))
                  or bool(re.search(r"\b(?:valid|invalid|uuid|pattern|format)\b", q)))
    # "多个客户端都能收到吗"这类多方共享/扇出问法，答案永远在 notes 机制层而非命令卡
    #（实录 Q283-285：notes 有"扇出还是独占"一节却未进上下文，模型按队列直觉答成排他消费）。
    mechanism = any(k in q for k in ("生命周期", "并发", "加锁", "锁机制", "路由", "重试", "ack", "回调",
                                         "投递", "状态机", "自动刷新", "自动注入", "缓存机制",
                                         "多个", "都能", "都会", "同时", "每个", "各自", "都收到", "扇出", "独占", "排他",
                                         "只有一个", "其余", "没反应", "没有反应", "收不到"))
    return {
        "why":     any(k in q for k in ("为什么", "原理", "机制", "不一致", "冲突", "原因", "根因", "归因",
                                             "导致", "怎么回事", "怎么判断", "什么逻辑", "逻辑", "核对代码", "源码")),
        "howmany": any(k in q for k in ("多少", "上限", "有效期", "配额", "几个", "多久", "时长", "过期")),
        "support": support,
        "capability": capability,
        "card_capability": card_capability,
        "validation": validation,
        "mechanism": mechanism,
        "truncated": _looks_truncated(q),
        "trouble": (any(k in q for k in ("报错", "错误", "失败", "异常", "打不开", "无权限", "暂无权限", "提示", "问题"))
                    or bool(re.search(r"\b(error|failed|failure|exception|denied|required unless|param_error)\b", q))),
        "enumerate": any(k in q for k in ("全部", "所有", "有哪些", "哪些", "盘点", "枚举", "什么类型", "哪种类型")),
        "version": (any(k in q for k in ("版本", "兼容", "升级", "上线", "发布版", "还能用", "正常使用"))
                    or bool(re.search(r"\bv?\d+\.\d+(?:\.\d+)?\b", q))),
        "semantic": (any(k in q for k in ("只是", "还是", "云端", "本地", "其他人", "影响", "区别", "范围", "限制",
                                                    "如果", "情况下", "先", "再", "然后", "之后", "前提"))
                     or (support and (len(q) > 40 or any(k in q for k in ("以及", "及", "和", "、", "分别"))))),
    }


def _card_path(kind, key):
    fn = f"{kind}--{quote(key.strip(), safe='-_.')}.md"
    return os.path.join(ROOT, "cards", "cmd", fn)


def _read_card(kind, key):
    p = _card_path(kind, key)
    if not os.path.exists(p):
        return None
    body = open(p, encoding="utf-8", errors="replace").read()
    return {"kind": kind, "key": key.strip(), "path": os.path.relpath(p, ROOT),
            "full": "\ncompleteness: full\n" in "\n" + body,
            "body": body.rstrip()}


def _evidence_contract(intent=None, has_card=True):
    """给模型可机械执行的证据边界；不把检索命中误当成运行时或后端事实。"""
    intent = intent or {}
    lines = ["== 证据契约(回答边界) =="]
    if has_card:
        lines.append("- 命令卡只证明卡内标出的 CLI 路径/Usage/参数/描述/源码锚点；partial 或未验证字段须继续查正文/源码。")
    else:
        lines.append("- 检索命中只证明所引原文明确写出的事实；相邻命令、字段或示例不能补成未写明的能力与因果。")
    lines.append("- 命令存在不证明后端接受某个具体值，也不证明真实运行结果、当前登录态或服务端行为；缺少显式校验源码时不得判 ID/参数非法。")
    if intent.get("truncated"):
        lines.append("- input_complete=no：输入含未闭合代码/结构，只可核对可见片段并要求补全，不得补猜缺失内容或根因。")
    if intent.get("validation"):
        lines.append("- value_validation：String 类型、示例外观、长度或前缀都不是格式约束；只有枚举/pattern/校验分支可证明合法性。")
    if intent.get("support") or intent.get("capability"):
        lines.append("- capability：某条命令存在只证明该入口存在；所问对象、消息类型和输出层级仍须由正文/源码直接覆盖。")
    if intent.get("card_capability"):
        lines.append("- card_axes：原始卡片结构、可读文本提取、结构化字段解析、渲染、解密是五项独立能力，须逐项核验，不得互相推出。")
    if intent.get("why") or intent.get("mechanism") or intent.get("trouble"):
        lines.append("- causality：报错根因/生命周期/机制须有对应代码路径；只有相关事实时只能标为推测并给用户自验步骤。")
    return lines


def _card_confident(rows, card=None):
    """首名明显胜出，或同分第二名是首卡确定性 Related 兄弟时才走快路径。"""
    if not rows:
        return False
    top = rows[0].get("_ctx_score", 0)
    name_score = rows[0].get("_ctx_name_score", 0)
    if top >= 100:                         # 命令名整句精确/前缀命中
        return name_score > 0
    second = rows[1].get("_ctx_score", 0) if len(rows) > 1 else 0
    clear = not second or top >= second * 1.15
    sibling_tie = False
    if card and len(rows) > 1 and second and abs(top - second) < 1e-6:
        r = rows[1]
        key = (r["cmd"].strip() if card["kind"] == "command"
               else f"{r.get('product', '')} {r['cmd']}".strip())
        sibling_tie = f"- dws {key}\n" in card["body"] + "\n"
    return name_score > 0 and top >= 6 and (clear or sibling_tie)


def ctx_impl(q, raw_terms, force_full=False):
    """打包检索。异常由 main 捕获转 CTX_ERROR。"""
    out = []
    intent = _intent(q)
    # 三表匹配:整句优先(精确);整句无果时逐词 OR 按命中词数排序。
    # 自然问句("oa 审批 实例 发起 附件 是否")整句永远匹配不到命令名,不降级则 cmd 恒为 0,
    # 模型会据此误判"命令不存在"(实录 Q238:把正确答案自我更正成错的)。
    def _pick3(rows, keyf, kws):
        ex = [r for r in rows if q in keyf(r)]
        if ex:
            # 命令名匹配优先于"描述里提到了这串":查 `chat message send` 时
            # `chat media upload` 的 desc 含"请通过 chat message send 发送本地文件",
            # 不排序就会把下线的兼容入口顶到正解前面。
            def _rank(r):
                c = (r.get("cmd") or "").strip().lower()
                return 0 if c == q else 1 if c.startswith(q) else 2
            ex.sort(key=_rank)
            for r in ex:
                rank = _rank(r)
                r["_ctx_score"] = 1000.0 if rank == 0 else 500.0 if rank == 1 else 100.0
                r["_ctx_name_score"] = r["_ctx_score"] if rank <= 1 else 0.0
            return ex
        if not kws:
            return ex
        # 按 IDF 加权而非命中词数:"创建/查询"这类泛用动词命中数百行,按词数计会把
        # agoal/aitable 之类无关命令顶到前面,把真正切题的挤出 top12(实录:问"创建空会话
        # 转发"返回 agoal obj-template)。用逆文档频率,词越常见权重越低,无需维护停用词表。
        hays = [keyf(r) for r in rows]
        n_rows = len(rows) or 1
        kws = _tokenize(kws, hays)
        if not kws:
            return []
        wt = {}
        for w in kws:
            df = sum(1 for h in hays if _hit(w, h))
            idf = math.log(n_rows / (1 + df)) if df else 0.0
            # 中文复合意图比拆散名词更具体:操作记录(4字)应胜过
            # 用户+获取+日志三个泛词之和。长度因子只用于纯中文,上限 2 倍。
            specific = min(2.0, 1.0 + 0.25 * (len(w) - 2)) \
                if re.fullmatch(r"[一-鿿]+", w) and len(w) >= 3 else 1.0
            wt[w] = idf * specific
        sc = []
        for h, r in zip(hays, rows):
            s = sum(wt[w] for w in kws if _hit(w, h))
            # 命令路径本身的命中比描述提及更强:问"怎么登录"时 auth login
            # 应明显胜过描述含"登录态迁移"的 auth migrate-keychain。
            name_h = (f"{r.get('product', '')} {r.get('cmd', '')}").strip().lower()
            name_s = sum(wt[w] for w in kws if _hit(w, name_h))
            s += 0.75 * name_s
            if s > 0:
                r["_ctx_score"] = s
                r["_ctx_name_score"] = name_s
                sc.append((-s, h[:60], r))
        sc.sort()
        return [r for _, _, r in sc[:12]]

    _kws = [w.lower() for w in raw_terms if len(w) > 1]
    # 问“卡片能否解析/读取”是在找读取投影，不是发送/更新入口；补充 list/pull
    # 检索词，避免稀有 token `card` 把 send-card 永远顶到 message list 前面。
    if intent["card_capability"]:
        _kws.extend(["list", "pull"])
    # keyf 并入 when(英文条目的适用场景常是唯一含义来源,desc 可能为空)
    _kf = lambda r: (r["cmd"] + " " + (r.get("desc") or "") + " " + (r.get("when") or "")).lower()
    command_rows = load("commands.jsonl")
    shortcut_rows = load("shortcuts.jsonl")
    cmds = _pick3(command_rows, _kf, _kws)
    shorts = _pick3(shortcut_rows, _kf, _kws)

    def _prefer_explicit(rows, hits, keyf):
        # 用户问题里贴了完整 `dws ...` 时，该字面命令锚点高于自然语言词频；
        # 最长路径优先，防 `oa approval` 父路径盖过 `oa approval detail`。
        anchored = []
        for r in rows:
            key = keyf(r).strip().lower()
            pat = r"(?<![a-z0-9])dws\s+" + re.escape(key).replace(r"\ ", r"\s+") + r"(?=\s|$)"
            if re.search(pat, q):
                r["_ctx_score"] = 2000.0 + len(key)
                r["_ctx_name_score"] = r["_ctx_score"]
                anchored.append(r)
        anchored.sort(key=lambda r: (-len(keyf(r)), keyf(r)))
        leaves = [r for r in anchored
                  if not any(keyf(other).startswith(keyf(r) + " ") for other in anchored if other is not r)]
        return leaves + [r for r in hits if r not in anchored]

    cmds = _prefer_explicit(command_rows, cmds, lambda r: r["cmd"])
    shorts = _prefer_explicit(shortcut_rows, shorts,
                              lambda r: f"{r.get('product', '')} {r['cmd']}".strip())
    if intent["card_capability"]:
        # 能力题优先读取/搜索消息的入口，不能让 send/update/read-status 仅因含 card/read
        # 抢走首卡；仍只在检索已命中的候选内重排，不凭空注入命令。
        def _card_read_rank(r):
            name = (f"{r.get('product', '')} {r.get('cmd', '')}").strip().lower()
            explicit = r.get("_ctx_score", 0) >= 2000
            reads_content = ("message" in name and any(x in name.split() for x in ("list", "search", "get", "pull"))
                             and "status" not in name)
            return (0 if explicit else 1 if reads_content else 2, -r.get("_ctx_score", 0), name)
        cmds.sort(key=_card_read_rank)
        shorts.sort(key=_card_read_rank)
    qq = q.lstrip("-")
    flag_hits = []
    for r in load("commands.jsonl"):
        for f in r.get("flags", []):
            if qq == f["name"] or qq in f["name"]:
                flag_hits.append(f"dws {r['cmd']}  --{f['name']}({f['type']})  {f.get('help','')[:60]}")
    # 篇目检索:整句子串对自然问句必落空("去重 ack 服务端"整串查不到,逐词各能命中),
    # 改为逐词 OR + 命中数排序;问法虚词不参与检索。
    _STOP = {"有没有", "支持", "能不能", "可以吗", "是否", "多少", "上限", "有效期", "配额",
             "几个", "多久", "时长", "过期", "为什么", "原理", "机制", "原因", "怎么回事",
             "需要", "客户端", "吗", "呢", "的", "做"}
    docs_hits = []
    mp = os.path.join(ROOT, "meta", "documents.jsonl")
    doc_rows = []
    if os.path.exists(mp):
        doc_rows = [json.loads(l) for l in open(mp, encoding="utf-8") if l.strip()]
    doc_hays = [(r["path"] + " " + " ".join(r.get("headings", []))).lower() for r in doc_rows]
    # 完整自然问句不能只按空格拆:"卡片消息能不能解析"须拆出 卡片/消息/解析，
    # 否则 notes 明明有实据仍会 0 命中。复用实体检索的脚本分段+领域最长匹配。
    kw = _tokenize(raw_terms, doc_hays)
    kw = [w for w in kw if w not in _STOP and len(w) > 1]
    if not kw:
        kw = [w.lower() for w in raw_terms if w.lower() not in _STOP and len(w) > 1] or [q]
    if doc_rows:
        # 词权重:泛用中文词(去重/服务端/消息…)在几十篇里都出现,靠"命中词数"排序会让
        # 无关篇挤掉关键篇(实录:aitable-record-stats 因标题含"去重+服务端"压过 event-system)。
        # 英文技术词/长词更具区分度,给高权重。
        def _w(word):
            if re.fullmatch(r"[a-z0-9_\-]+", word):
                return 5          # ack / consume / webhook 这类
            return 2 if len(word) >= 4 else 1
        sd = []
        for r, hay in zip(doc_rows, doc_hays):
            sc = sum(_w(w) for w in kw if _hit(w, hay))
            if sc:
                sd.append((-sc, r["path"], r))
        sd.sort()
        docs_hits = [r for _, _, r in sd]

    # 答案卡分支可由 --full 或 KB_NO_CARDS=1 一键关闭；卡片不存在也自动退化旧全文。
    cards_enabled = (not force_full and os.environ.get("KB_NO_CARDS") != "1"
                     and os.path.isdir(os.path.join(ROOT, "cards", "cmd")))
    # 主命令与 shortcut 统一竞选,全局只展开首名一张卡；多卡曾让输出 7.2KB，
    # 比旧全文 6.1KB 还大，违背性能目标。其余候选只留一行摘要。
    choices = []
    if cmds:
        choices.append((cmds[0].get("_ctx_score", 0), "command", cmds[0], cmds))
    if shorts:
        choices.append((shorts[0].get("_ctx_score", 0), "shortcut", shorts[0], shorts))
    choices.sort(key=lambda x: (-x[0], x[1]))
    top_score, top_kind, top_row, top_family = choices[0] if choices else (0, "", None, [])
    top_key = ((top_row["cmd"].strip()) if top_kind == "command" else
               (f"{top_row.get('product', '')} {top_row['cmd']}".strip()) if top_row else "")
    top_card = _read_card(top_kind, top_key) if cards_enabled and top_row else None
    # 卡片只回答命令契约；支持性、因果、校验、机制、数值、报错、枚举、版本、
    # 语义后果与未闭合输入必须保留正文/notes，不能由“命令存在”直接推出结论。
    card_blocked = any(intent[k] for k in
                       ("why", "howmany", "support", "capability", "validation", "mechanism",
                        "truncated", "trouble", "enumerate", "version", "semantic"))
    card_fast = bool(top_card and top_card["full"] and _card_confident(top_family, top_card)
                     and not card_blocked)
    card_items = [top_card] if top_card else []

    # 支持性/枚举题：否定前先看到"知识库里存在什么"。清单来自已算好的 IDF 命中，不加检索；
    # 放在答案卡之前是因为模型读到首卡就定调（实录 Q186 把 data-auth cross-org 埋在候选第 4 行，
    # 答"没有跨组织命令"；Q170 无视 notes 答"没有 24 小时说法"）。
    if (intent["support"] or intent["enumerate"]) and (cmds or shorts):
        out.append("== 否定前必读：本轮命中的相关命令（说「没有/不支持」前须逐条说明为何不满足所问）==")
        for r in cmds[:6]:
            out.append(f"- dws {r['cmd']}  —  {(r.get('desc') or '')[:60]}")
        for r in shorts[:4]:
            out.append(f"- dws {r.get('product', '')} {r['cmd']}  —  {(r.get('desc') or '')[:60]}")
        for r in docs_hits[:4]:
            out.append(f"- 篇目 {r['path']}: {' / '.join((r.get('headings') or [])[:5])[:80]}")
        out.append("(以上为实体表精确命中，存在即事实；未列出≠不存在，仍须 cmd|short|flag 换词三查后才可否定)")
    if card_items:
        out.append("== 答案卡(card:full 仅可直接回答卡内 CLI 契约;partial 必须继续看正文) ==")
        for c in card_items:
            out.append(c["body"])
        seen_cards = {(c["kind"], c["key"]) for c in card_items}
        other_cmds = []
        for r in cmds[:8]:
            if ("command", r["cmd"].strip()) not in seen_cards:
                other_cmds.append(f"● dws {r['cmd']}  —  {r['desc']}")
        other_shorts = []
        for r in shorts[:6]:
            key = f"{r.get('product', '')} {r['cmd']}".strip()
            if ("shortcut", key) not in seen_cards:
                other_shorts.append(f"● dws {key}  —  {r['desc']}")
        if other_cmds or other_shorts:
            out.append("== 其他候选(仅摘要;固定保留 shortcut 配额) ==")
            out.extend(other_cmds[:5] + other_shorts[:3])
    else:
        # 回退路径保持 R10.1 行为不变。
        if cmds:
            out.append("== 命令命中(cmd) ==")
            for r in cmds[:8]:
                out.append(f"● dws {r['cmd']}  —  {r['desc']}")
                for d in r.get("defs", [])[:1]:
                    out.append(f"  源码: {d['file']}:{d['line']}")
                if len(cmds) <= 3:
                    for f in r.get("flags", []):
                        marks = "(必填)" if f.get("required") else ""
                        out.append(f"    --{f['name']}  {f['type']}{marks}  {f.get('help','')[:70]}")
        if shorts:
            out.append("== 短命令命中(short) ==")
            for r in shorts[:6]:
                out.append(f"● dws {r['product']} {r['cmd']}  —  {r['desc']}\n  源码: {r['file']}:{r['line']}")
    if flag_hits:
        out.append("== flag 命中 ==")
        out.extend(flag_hits[:8])

    out.extend(_evidence_contract(intent, has_card=bool(card_items)))

    # 相关篇目:products/command-index 优先于 notes;各取 top,正文入包
    ent_total = len(cmds) + len(shorts) + len(flag_hits)
    body_cap = 5000 if ent_total >= 1 else _CTX_BODY_CAP
    # 复杂问法的答案常在 notes 而非产品文档；能力边界、值校验、机制和排障
    # 不能因答案卡退出 fast 后只塞一篇泛产品文档。普通支持性判断由命令卡+产品
    # 正文回答，只有同时属于上述复杂意图时才补 notes，避免无关语义篇干扰。
    _needs_notes = any(intent[k] for k in
                       ("why", "howmany", "capability", "card_capability", "validation", "mechanism", "trouble"))
    _mech = _needs_notes
    # full 卡 + 首名明显胜出 + 非机制/数值/支持/排障/枚举题时，正文归零；
    # 任一条件不满足就保持 R10.1 的 1~2 篇正文，准确率优先。
    _n_body = 0 if card_fast else (1 if (_mech and not (cmds or shorts))
                                   else (1 if ent_total >= 1 else 2))
    # docs_hits 已按相关度排序；旧代码再按路径字母序排序会把 aisearch 等无关篇目
    # 固定顶到 chat/oa 前面。优先镜像 docs 但保持相关度，只有 docs 全空才用 notes。
    primary_docs = [r for r in docs_hits if r["layer"] in ("docs", "mirror")]
    if top_row and top_row.get("product"):
        product_prefix = f"docs/products/{top_row['product']}"
        # 产品根文档可能因标题未出现自然语言关键词而不在 docs_hits；命令实体已确定
        # product 时可机械补入对应镜像，不属于猜测。
        product_docs = [r for r in doc_rows
                        if r["layer"] in ("docs", "mirror")
                        and (r["path"] == product_prefix + ".md"
                             or r["path"].startswith(product_prefix + "/"))]
        product_docs.sort(key=lambda r: (r["path"] != product_prefix + ".md", r["path"]))
        primary_docs = product_docs + [r for r in primary_docs if r not in product_docs]
    body_docs = (primary_docs or docs_hits)[:_n_body]
    for i, r in enumerate(body_docs):
        p = os.path.join(ROOT, r["path"])
        if not os.path.exists(p):
            continue
        body = open(p, encoding="utf-8", errors="replace").read()
        if len(body) > body_cap:
            body = body[:body_cap] + f"\n…[已截断,完整: dwsdoc cat {r['path']}]"
        out.append(f"\n== 篇目[{i+1}/{len(body_docs)}] {r['path']} [{r['layer']}] ==")
        out.append(body)
    others = [r["path"] for r in docs_hits if r not in body_docs][:8]
    if others:
        out.append("\n== 其他篇目(未展开) ==")
        out.extend("  " + p for p in others)

    # 机制类问法:直接并入 notes/ 命中节,免去"查完发现要读 notes"的第二轮。
    # 必须在"0 命中提前返回"之前执行——机制题常在三表查不到(问的是行为不是命令名),
    # 恰恰最需要 notes,若放在后面会被短路掉。
    # 机制/数值题大概率要读源码:后台预拉,模型读完上文再需要时通常已就位。
    # ⚠️ 实测教训(2026-09-02):预拉若与主 wiki 下载并发会抢带宽,首题被拖到 168s、
    # 次题直接超时。故:① 仅在 wiki 已就位(本进程能正常读到 graph/)时才拉——
    # 此时主下载必然已完成;② 加 --limit-rate 留出余量;③ 全程 nice 降优先级。
    if (intent["why"] or intent["howmany"]) and os.path.exists(os.path.join(ROOT, "graph", "commands.jsonl")):
        try:
            kb = os.environ.get("QA_KB_DIR") or os.path.join(os.path.expanduser("~"), ".knowledge")
            src = os.path.join(kb, "dingtalk-workspace-cli-main")
            if not os.path.exists(os.path.join(src, "CHANGELOG.md")):
                import subprocess
                sh = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "ops", "fetch_source.sh")
                url = "https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli/archive/refs/heads/main.tar.gz"
                subprocess.Popen(
                    ["nice", "-n", "19", "bash", "-c",
                     f'sleep 3; curl -sfL -m 600 --limit-rate 2M -o "{kb}/.src.tgz" "{url}" && '
                     f'python3 -c "import tarfile,sys;t=tarfile.open(\'{kb}/.src.tgz\');'
                     f't.extractall(\'{kb}/.tsrc\')" && '
                     f'mv "{kb}/.tsrc/dingtalk-workspace-cli-main" "{src}" 2>/dev/null; '
                     f'rm -rf "{kb}/.tsrc" "{kb}/.src.tgz"'],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except Exception:
            pass

    notes_hit = 0
    if not card_fast and _needs_notes:
        nd = os.path.join(ROOT, "notes")
        # 整句常匹配不上,按词拆(去掉问法词本身),命中任一实词即取该节。
        words = kw
        if os.path.isdir(nd) and words:
            picked = []
            # 卡片能力/值校验题通常只有一个直接相关 note；只取首篇可减少约 3KB 噪音。
            # 广义因果、数值或普通排障题可能横跨两篇，仍保留两篇配额。
            focused = intent["card_capability"] or intent["validation"]
            note_limit = 1 if focused else 2
            # 按命中密度挑文件与小节:泛词几乎每篇都有,字母序会让无关篇先占满名额。
            ranked = []
            for fn in os.listdir(nd):
                if not fn.endswith(".md"):
                    continue
                body = open(os.path.join(nd, fn), encoding="utf-8", errors="replace").read()
                low = body.lower()
                distinct = sum(_w(w) for w in words if _hit(w, low))
                total = sum(low.count(w) for w in words)
                if distinct:
                    ranked.append((-(distinct * 100 + total), fn, body))
            ranked.sort()
            for _, fn, body in ranked[:note_limit]:
                # frontmatter/导语不是小节，命中泛词时不应与真正相关的小节争 top2。
                secs = [s for s in re.split(r"\n(?=#{2,3} )", body)
                        if s.lstrip().startswith(("## ", "### "))]
                def _sec_score(sec):
                    low = sec.lower()
                    head = low.splitlines()[0]
                    return (sum(_w(w) for w in words if _hit(w, low))
                            + 3 * sum(1 for w in words if _hit(w, head)))
                sc = sorted(((_sec_score(s), i, s) for i, s in enumerate(secs)), key=lambda x: (-x[0], x[1]))
                # 排障/机制题的正解小节常排第 3(实录 Q283 "扇出还是独占"被锁/消费端两节压住)
                n_secs = 3 if (intent["trouble"] or intent["why"] or intent["mechanism"]) else 2
                hit = [s for n_, _, s in sc[:n_secs] if n_ > 0]
                picked.append(f"--- notes/{fn} ---\n" + ("\n".join(hit) if hit else body[:2000])[:3000])
            if picked:
                notes_hit = len(picked)
                out.append("\n== 行为语义(notes,复杂问法自动并入) ==")
                out.extend(picked)
    # 支持性/版本题:产品行为变更常只记录在 CHANGELOG(实录 Q200 "通过AI发送文案能否改"答案在
    # DWS_AGENT_PRODUCT 条目)。只用 ASCII 实现词(含术语表映射)逐行 grep,最多 6 行。
    changelog_hits = 0
    if intent["support"] or intent["version"]:
        cl = os.path.join(ROOT, "docs", "CHANGELOG.md")
        action_ascii = {v for g in _TERM_GROUPS[:12] for v in g if re.fullmatch(r"[a-z\-]+", v)}
        ascii_terms = {v for w in kw for v in _VARIANTS.get(w, (w,))
                       if re.fullmatch(r"[a-z][a-z0-9_\-]{3,}", v) and v not in action_ascii}
        if os.path.exists(cl) and ascii_terms:
            lines = []
            for line in open(cl, encoding="utf-8", errors="replace"):
                low = line.lower()
                if any(re.search(r"(?<![a-z0-9])" + re.escape(t) + r"(?![a-z0-9])", low) for t in ascii_terms):
                    # 单行放宽到 420:CHANGELOG 条目常把结论放在句尾(实录 Q200 "change the displayed
                    # label" 在第 230 字符后被截掉,模型据前半句答成"不可改")。
                    lines.append(line.strip()[:420])
                    if len(lines) >= 6:
                        break
            if lines:
                changelog_hits = len(lines)
                out.append("\n== CHANGELOG 命中行(版本/行为变更以此为准) ==")
                out.extend("  " + l for l in lines)
    out.append("\n== 检索审计 ==")
    out.append(f"已检索: card/cmd/short/flag/find/notes/changelog · 关键词: {' '.join(raw_terms)}"
               f" · 命中: card={len(card_items)}(fast={int(card_fast)})"
               f" cmd={len(cmds)} short={len(shorts)} flag={len(flag_hits)}"
               f" find={len(docs_hits)} notes={notes_hit} changelog={changelog_hits}")
    out.append("== 继续 ==")
    hint = ["盘点用 dwsdoc cmd <产品>+short <产品> 枚举全量", "版本判定 cat docs/CHANGELOG.md"]
    if card_fast:
        hint.insert(0, "答案卡为 full 且首名明显胜出:仅按卡内 CLI 契约直接作答,无需再 cat")
    if intent["howmany"]:
        hint.insert(0, "⚠️数值/时限类:上文若无确切数字,必须二级拉源码后 grep 常量(如 DefaultRefreshTokenLifetime),禁止用「无固定时长」回避")
    if intent["why"]:
        hint.append("机制结论须落到源码函数并复述其行为")
    out.append(";".join(hint))

    if not (cmds or shorts or flag_hits or docs_hits or notes_hit):
        print("\n".join(_evidence_contract(intent, has_card=False)))
        print("== 检索审计 ==")
        print(f"已检索: cmd/short/flag/find · 关键词: {' '.join(raw_terms)} · 命中: 0")
        print("== 继续 ==")
        print("换中文能力词/英文命令词重试 ctx(如 永久授权→permanent);仍无→二级拉源码 grep;查不到只可标「待确认」。")
        return 1
    text = "\n".join(out)
    if len(text) > _CTX_TOTAL_CAP:
        text = text[:_CTX_TOTAL_CAP] + "\n…[ctx 总量截断,用 dwsdoc cat 读完整篇目]"
    print(text)
    return 0

ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))


def load(name):
    p = os.path.join(ROOT, "graph", name)
    return [json.loads(l) for l in open(p, encoding="utf-8")] if os.path.exists(p) else []


def show_cmd(r, full=True):
    print(f"● dws {r['cmd']}  —  {r['desc']}")
    if r.get("when"):
        print(f"  适用: {r['when']}")
    for d in r.get("defs", [])[:1]:
        print(f"  源码: {d['file']}:{d['line']}")
    if full:
        for f in r.get("flags", []):
            marks = "".join(["(必填)" if f.get("required") else "",
                             "(隐藏)" if f.get("hidden") else ""])
            print(f"    --{f['name']}"
                  + (f"/-{f['short']}" if f.get("short") else "")
                  + f"  {f['type']}{marks}  {f.get('help','')}"
                  + f"  [:{f['line']}]")


def show_short(r):
    print(f"● dws {r['product']} {r['cmd']}  —  {r['desc']}")
    print(f"  源码: {r['file']}:{r['line']}")
    for f in r.get("flags", []):
        print(f"    --{f['name']}  {f['type']}  {f.get('desc','')}")


def card_impl(q):
    q = q.removeprefix("dws ").strip().lower()
    candidates = []
    for r in load("commands.jsonl"):
        key = r["cmd"].strip()
        hay = (key + " " + (r.get("desc") or "")).lower()
        if q == key.lower() or q in hay:
            rank = 0 if q == key.lower() else 1 if key.lower().startswith(q) else 2
            candidates.append((rank, key, "command"))
    for r in load("shortcuts.jsonl"):
        key = f"{r.get('product', '')} {r['cmd']}".strip()
        hay = (key + " " + (r.get("desc") or "")).lower()
        if q == key.lower() or q in hay:
            rank = 0 if q == key.lower() else 1 if key.lower().startswith(q) else 2
            candidates.append((rank, key, "shortcut"))
    shown = 0
    for _, key, kind in sorted(candidates)[:6]:
        card = _read_card(kind, key)
        if not card:
            continue
        if shown:
            print("\n---\n")
        print(card["body"])
        shown += 1
        if shown >= 3:
            break
    if not shown:
        print(f"未找到答案卡: {q};用 dwsdoc cmd/short 查实体,或 ctx --full 走正文")
        return 1
    print()
    print("\n".join(_evidence_contract(_intent(q), has_card=True)))
    return 0


def main():
    if len(sys.argv) < 3:
        print(__doc__)
        return 2
    op = sys.argv[1]
    if op == "ctx":
        try:
            # --full 是独立回退开关;其余调用方可能传多参数(ctx a b c)或引号整串。
            args = [x for x in sys.argv[2:] if x != "--full"]
            force_full = len(args) != len(sys.argv[2:])
            if not args:
                print(__doc__)
                return 2
            q = " ".join(args).lower()
            terms = args
            if len(terms) == 1:
                terms = [w for w in re.split(r"[\s,，、]+", terms[0]) if w]
            return ctx_impl(q, terms, force_full=force_full)
        except Exception as e:
            print(f"CTX_ERROR: {type(e).__name__}: {e};请改用分步命令(cmd/short/flag→find→cat)")
            return 1
    q = " ".join(sys.argv[2:]).lower()
    if op == "card":
        return card_impl(q)
    if op == "cmd":
        hits = [r for r in load("commands.jsonl")
                if q in r["cmd"].lower() or q in r["desc"].lower()]
        for r in hits[:12]:
            show_cmd(r, full=len(hits) <= 4)
        print(f"-- {len(hits)} 条命中(主命令树)。另可试 dwsdoc short {q}")
    elif op == "short":
        hits = [r for r in load("shortcuts.jsonl")
                if q in r.get("product", "").lower()
                or q in r["cmd"].lower() or q in r["desc"].lower()]
        for r in hits[:12]:
            show_short(r)
        print(f"-- {len(hits)} 条命中(shortcut)")
    elif op == "flag":
        qq = q.lstrip("-")
        n = 0
        for r in load("commands.jsonl"):
            for f in r.get("flags", []):
                if qq == f["name"] or qq in f["name"]:
                    print(f"dws {r['cmd']}  --{f['name']}({f['type']})  {f.get('help','')}")
                    n += 1
        for r in load("shortcuts.jsonl"):
            for f in r.get("flags", []):
                if qq == f["name"] or qq in f["name"]:
                    print(f"dws {r['product']} {r['cmd']}  --{f['name']}({f['type']})  {f.get('desc','')}")
                    n += 1
        print(f"-- {n} 处定义")
    elif op == "find":
        mp = os.path.join(ROOT, "meta", "documents.jsonl")
        for l in open(mp, encoding="utf-8"):
            r = json.loads(l)
            hay = (r["path"] + " " + " ".join(r.get("headings", []))).lower()
            if q in hay:
                print(f"{r['path']}  [{r['layer']}]  {' / '.join(r.get('headings', [])[:4])}")
    elif op == "cat":
        p = os.path.join(ROOT, sys.argv[2])
        if not os.path.abspath(p).startswith(ROOT) or not os.path.exists(p):
            print("不存在:", sys.argv[2])
            return 1
        sys.stdout.write(open(p, encoding="utf-8", errors="replace").read())
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
